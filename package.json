{
  "name": "kest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "check": "bun check --no-script",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --check --no-script",
